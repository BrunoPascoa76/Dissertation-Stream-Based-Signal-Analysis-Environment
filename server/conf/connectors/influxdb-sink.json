{
  "name": "influxdb-sink",
  "config": {
    "connector.class": "io.confluent.influxdb.InfluxDBSinkConnector",
    "consumer.override.auto.offset.reset": "earliest",
    "tasks.max": "5",
    "topics": "mqtt",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "transforms": "ForceFloat",
    "transforms.ForceFloat.type": "org.apache.kafka.connect.transforms.Cast$Value",
    "transforms.ForceFloat.spec": "value_f$:float64",

    "influxdb.url": "http://influxdb:8086",
    "influxdb.db": "mqtt",
    "influxdb.retention.policy": "autogen",
    
    "influxdb.measurement.field": "measurement",
    "influxdb.time.fieldname": "timestamp",
    "influxdb.timeunit": "MILLISECONDS",
    "influxdb.tags": "uuid",

    "errors.tolerance": "all",
    "errors.log.enable": true
  }
}